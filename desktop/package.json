{
  "name": "proxy-helper-desktop",
  "version": "5.0.0",
  "description": "Proxy Helper desktop",
  "author": "Proxy Helper",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.proxyhelper.desktop",
    "productName": "ProxyHelper",
    "files": [
      "*.cjs",
      "*.html",
      "*.ps1"
    ],
    "win": {
      "target": "zip",
      "icon": "../Windows/ProxyHelper.ico",
      "signExecutable": false
    }
  }
}
